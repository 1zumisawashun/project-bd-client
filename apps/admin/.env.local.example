# apps/web の .env.local にある NEXTAUTH_SECRET と同じ値にすること
# （同一のセッションCookieを検証するため。apps/web はNEXTAUTH_SECRETを使っているためこちらも揃える）
# https://authjs.dev/reference/nextjs#environment-variable-inference
NEXTAUTH_SECRET=

# ログイン画面など、admin側に存在しないルートへリダイレクトする際の遷移先。
# 未設定時は http://localhost:3000 を使う
WEB_APP_URL=http://localhost:3000
