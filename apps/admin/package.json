{
  "name": "@project-bd-client/admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite --port 3002",
    "preview": "vite preview --port 3002",
    "lint": "pnpm lint:eslint && pnpm lint:oxlint",
    "lint:eslint": "npx eslint 'src/**/*.{ts,tsx}' --cache",
    "lint:eslint:fix": "npx eslint 'src/**/*.{ts,tsx}' --cache --fix",
    "lint:fix": "pnpm lint:eslint:fix && pnpm lint:oxlint:fix",
    "lint:oxlint": "npx oxlint --type-aware --type-check --tsconfig ./tsconfig.json",
    "lint:oxlint:fix": "npx oxlint --type-aware --type-check --tsconfig ./tsconfig.json --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npx tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@hookform/lenses": "^0.10.0",
    "@hookform/resolvers": "^3.9.0",
    "@project-bd-client/ui": "workspace:*",
    "@radix-ui/react-icons": "^1.3.0",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.42",
    "@tiptap/extension-character-count": "^2.5.9",
    "@tiptap/extension-focus": "^2.5.9",
    "@tiptap/extension-hard-break": "^2.5.9",
    "@tiptap/extension-image": "^2.5.9",
    "@tiptap/extension-link": "^2.5.9",
    "@tiptap/extension-paragraph": "^2.5.9",
    "@tiptap/extension-placeholder": "^2.5.9",
    "@tiptap/extension-text-align": "^2.5.9",
    "@tiptap/pm": "^2.5.9",
    "@tiptap/react": "^2.5.9",
    "@tiptap/starter-kit": "^2.5.9",
    "clsx": "^2.1.1",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.52.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@project-bd-client/eslint-config": "workspace:*",
    "@project-bd-client/tsconfig": "workspace:*",
    "@tanstack/router-plugin": "^1.168.43",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/eslint": "^9.6.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-oxlint": "^1.24.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.24.0",
    "oxlint-tsgolint": "^0.11.1",
    "typescript": "^5",
    "vite": "^8.0.0",
    "vitest": "^4.1.11"
  }
