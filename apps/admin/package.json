{
  "name": "@project-bd-client/admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev -p 3001",
    "lint": "pnpm lint:eslint && pnpm lint:oxlint",
    "lint:eslint": "npx eslint 'app/**/*.{ts,tsx}' --cache",
    "lint:eslint:fix": "npx eslint 'app/**/*.{ts,tsx}' --cache --fix",
    "lint:fix": "pnpm lint:eslint:fix && pnpm lint:oxlint:fix",
    "lint:oxlint": "npx oxlint --type-aware --type-check --tsconfig ./tsconfig.json",
    "lint:oxlint:fix": "npx oxlint --type-aware --type-check --tsconfig ./tsconfig.json --fix",
    "start": "next start -p 3001",
    "typecheck": "npx tsc --noEmit"
  },
  "dependencies": {
    "@project-bd-client/auth": "workspace:*",
    "@project-bd-client/db": "workspace:*",
    "@project-bd-client/ui": "workspace:*",
    "next": "14.2.35",
    "next-auth": "^5.0.0-beta.20",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^15.1.3",
    "@project-bd-client/eslint-config": "workspace:*",
    "@project-bd-client/tsconfig": "workspace:*",
    "@types/eslint": "^9.6.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^9.26.0",
    "eslint-config-next": "^15.1.3",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-oxlint": "^1.24.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "oxlint": "^1.24.0",
    "oxlint-tsgolint": "^0.11.1",
    "typescript": "^5"
  }
}
